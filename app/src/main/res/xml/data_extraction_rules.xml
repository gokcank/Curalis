<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Room veritabanı kasıtlı olarak hariç tutulur: OS seviyesi otomatik yedekleme/cihaz
         aktarımı, eski bir kuruluma ait ham .db dosyasını geri yükleyebilir ve bu dosyanın
         şema sürümü uygulamanın güncel migration zincirinin (bkz. DatabaseMigrations.kt)
         kapsamadığı kadar eski olabilir — açılışta "migration not found" çökmesine yol
         açar. Kullanıcının kendi Yedekleme & Geri Yükleme özelliği (şifreli, yapılandırılmış
         JSON tabanlı, bkz. LocalBackupManager) bu riski taşımaz ve zaten mevcut. -->
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
